          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "default": "default"
                  },
                  "names": {
                    "type": "object",
                    "properties": {
                      "vi": {
                        "type": "string"
                      },
                      "en": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "vi"
                    ]
                  },
                  "startsAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "endsAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "mirrorOf": {
                    "type": "string",
                    "description": "vd \"default\": nhận tự động điểm của bảng này trong thời gian giải"
                  },
                  "order": {
                    "type": "string",
                    "enum": [
                      "ASC",
                      "DESC"
                    ]
                  },
                  "maxScore": {
                    "type": "integer"
                  },
                  "minScore": {
                    "type": "integer"
                  },
                  "maxScorePerSecond": {
                    "type": "number"
                  }
                },
                "required": [
                  "key",
                  "names"
                ]
              }
            }
          }
        },
