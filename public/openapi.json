{
  "openapi": "3.1.0",
  "info": {
    "title": "Monlabs Play API",
    "version": "1.0.0",
    "description": "Client API (/api/p1) cho game chạy trên domain riêng (publishable key + domain đã khai báo + token người chơi) và Server API (/api/s1) cho máy chủ của game (secret key). Lỗi luôn có dạng { error: { code, message } }. Tài liệu: https://docs.monlabs.fun/server-api"
  },
  "servers": [
    {
      "url": "https://play.monlabs.fun"
    }
  ],
  "tags": [
    {
      "name": "Client API",
      "description": "Gọi từ trình duyệt (SDK dùng sẵn). Header x-gamehub-key + Origin nằm trong danh sách domain."
    },
    {
      "name": "Server API",
      "description": "Gọi từ máy chủ của game. Authorization: Bearer sk_live_…. Không hỗ trợ CORS."
    },
    {
      "name": "Webhook",
      "description": "Sự kiện POST tới URL webhook của project, header x-monlabs-signature: t=<unix>,v1=<hex HMAC-SHA256(secret, t + '.' + body)>."
    }
  ],
  "components": {
    "securitySchemes": {
      "publishableKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-gamehub-key",
        "description": "pk_live_… – công khai, chỉ chạy trên domain đã khai báo"
      },
      "playerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token người chơi từ /api/p1/auth/verify hoặc /api/p1/auth/guest (7 ngày, chỉ dùng cho 1 project)"
      },
      "secretKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "sk_live_… – CHỈ dùng trên máy chủ"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "examples": [
                  "INVALID_SECRET_KEY",
                  "SESSION_NOT_FOUND",
                  "SERVER_SCORING_ONLY",
                  "PLAYER_BANNED",
                  "PLAY_TOO_SHORT",
                  "RATE_LIMITED"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        }
      },
      "Player": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "walletAddress": {
            "type": [
              "string",
              "null"
            ]
          },
          "isGuest": {
            "type": "boolean"
          }
        }
      },
      "SubmitResult": {
        "type": "object",
        "properties": {
          "score": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "integer"
              },
              "durationSeconds": {
                "type": "integer"
              },
              "leaderboard": {
                "type": "string"
              }
            }
          },
          "isNewBest": {
            "type": "boolean"
          },
          "best": {
            "type": "integer"
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ]
          },
          "tournaments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "rank": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "WebhookEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id lần gửi – dùng để bỏ qua sự kiện trùng"
          },
          "type": {
            "type": "string",
            "enum": [
              "score.submitted",
              "ping"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "gameId": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "description": "score.submitted",
            "properties": {
              "scoreId": {
                "type": "string"
              },
              "sessionId": {
                "type": "string"
              },
              "playerId": {
                "type": "string"
              },
              "leaderboard": {
                "type": "string"
              },
              "value": {
                "type": "integer"
              },
              "durationSeconds": {
                "type": "integer"
              },
              "isNewBest": {
                "type": "boolean"
              },
              "tournaments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "via": {
                "type": "string",
                "enum": [
                  "client",
                  "server"
                ]
              }
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Lỗi",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/p1/project": {
      "get": {
        "tags": [
          "Client API"
        ],
        "summary": "Thông tin project",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "publishableKey": []
          }
        ]
      }
    },
    "/api/p1/auth/nonce": {
      "post": {
        "tags": [
          "Client API"
        ],
        "summary": "Lấy thông điệp SIWE để ký",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string"
                  },
                  "chainId": {
                    "type": "integer"
                  }
                },
                "required": [
                  "address"
                ]
              }
            }
          }
        },
        "security": [
          {
            "publishableKey": []
          }
        ]
      }
    },
    "/api/p1/auth/verify": {
      "post": {
        "tags": [
          "Client API"
        ],
        "summary": "Gửi chữ ký → token người chơi",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "expiresIn": {
                      "type": "integer"
                    },
                    "player": {
                      "$ref": "#/components/schemas/Player"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "signature": {
                    "type": "string"
                  }
                },
                "required": [
                  "message",
                  "signature"
                ]
              }
            }
          }
        },
        "security": [
          {
            "publishableKey": []
          }
        ]
      }
    },
    "/api/p1/auth/guest": {
      "post": {
        "tags": [
          "Client API"
        ],
        "summary": "Chơi khách → token người chơi",
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "publishableKey": []
          }
        ]
      }
    },
    "/api/p1/auth/logout": {
      "post": {
        "tags": [
          "Client API"
        ],
        "summary": "Đăng xuất (thu hồi token)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "publishableKey": [],
            "playerToken": []
          }
        ]
      }
    },
    "/api/p1/me": {
      "get": {
        "tags": [
          "Client API"
        ],
        "summary": "Người chơi hiện tại",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "publishableKey": [],
            "playerToken": []
          }
        ]
      }
    },
    "/api/p1/sessions": {
      "post": {
        "tags": [
          "Client API"
        ],
        "summary": "Bắt đầu lượt chơi → { sessionId }",
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessionId": {
                      "type": "string"
                    },
                    "startedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "publishableKey": [],
            "playerToken": []
          }
        ]
      }
    },
    "/api/p1/scores": {
      "post": {
        "tags": [
          "Client API"
        ],
        "summary": "Nộp điểm (game ở chế độ nhận điểm từ trình duyệt)",
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sessionId": {
                    "type": "string"
                  },
                  "score": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "leaderboard": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "default": "default"
                  }
                },
                "required": [
                  "sessionId",
                  "score"
                ]
              }
            }
          }
        },
        "security": [
          {
            "publishableKey": [],
            "playerToken": []
          }
        ]
      }
    },
    "/api/p1/leaderboards": {
      "get": {
        "tags": [
          "Client API"
        ],
        "summary": "Các bảng xếp hạng / giải đấu",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "publishableKey": []
          }
        ]
      }
    },
    "/api/p1/leaderboard": {
      "get": {
        "tags": [
          "Client API"
        ],
        "summary": "Top + hạng của tôi",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "board",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "default": "default"
            },
            "description": "Key bảng"
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "all"
              ],
              "default": "all"
            },
            "description": "Kỳ"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "description": "Số dòng"
          }
        ],
        "security": [
          {
            "publishableKey": []
          }
        ]
      }
    },
    "/api/s1/project": {
      "get": {
        "tags": [
          "Server API"
        ],
        "summary": "Kiểm tra secret key, xem project",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
