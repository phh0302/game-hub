# Kết nối PostgreSQL (khớp với docker-compose.yml)
DATABASE_URL="postgresql://gamehub:gamehub@localhost:5433/gamehub?schema=public"

# Khóa ký JWT – chuỗi ngẫu nhiên tối thiểu 32 ký tự
# Tạo mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu"

# Danh sách ví admin, cách nhau bằng dấu phẩy (vd: 0xabc...,0xdef...)
ADMIN_WALLETS=""

# URL gốc của web – domain này phải khớp với domain trong thông điệp SIWE
NEXT_PUBLIC_APP_URL="http://localhost:3000"
