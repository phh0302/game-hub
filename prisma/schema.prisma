// Game Hub – database schema (Phase 2.5: thiết kế để mở rộng)
//
// Nguyên tắc: tính năng mới = THÊM bảng / THÊM dòng, không sửa cột cũ.
// - Cách đăng nhập tách khỏi User (AuthIdentity) → thêm Google/email/khách không đổi bảng User
// - Bản dịch, thể loại, phiên bản game, bảng xếp hạng đều là bảng riêng
// - Cấu hình riêng từng game/bảng xếp hạng lưu JSON (settings) → thêm luật không cần migration
// - Không xóa cứng dữ liệu quan trọng: dùng deletedAt / trạng thái ARCHIVED
// - File (ảnh, game) lưu "key" tương đối, URL đầy đủ ghép từ cấu hình

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Kết nối khi chạy web (production: URL qua pooler của Neon/Supabase)
  url       = env("DATABASE_URL")
  /// Kết nối trực tiếp để chạy migration (máy dev: giống DATABASE_URL)
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ───────────────────────────── Người dùng & đăng nhập ─────────────────────────────

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  WALLET // ví Ethereum (MetaMask) – providerUserId = địa chỉ ví chữ thường
  GOOGLE // dự phòng cho sau này
  EMAIL // dự phòng cho sau này
  GUEST // người chơi khách – providerUserId = mã khách lưu trong cookie
}

model User {
  id          String    @id @default(cuid())
  username    String?   @unique
  avatarKey   String?
  role        Role      @default(USER)
  /// Tài khoản khách: chơi không cần đăng nhập, sau này gắn ví vào là giữ nguyên dữ liệu
  isGuest     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  deletedAt   DateTime?
  /// Admin khóa tài khoản: không đăng nhập được, mọi phiên đăng nhập bị thu hồi
  suspendedAt   DateTime?
  suspendReason String?

  identities    AuthIdentity[]
  studioMembers StudioMember[]
  sessions      GameSession[]
  scores        Score[]
  events        Event[]
  reports       GameReport[]
  authSessions  AuthSession[]
}

/// Phiên đăng nhập (id nằm trong JWT dưới dạng jti) → đăng xuất / khóa tài khoản có hiệu lực ngay
model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  userAgent  String?
  ip         String?
  /// Phiên của Client API (game chạy trên domain riêng) chỉ dùng được cho đúng game này;
  /// null = phiên đăng nhập trên chính Game Hub
  gameId     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([gameId])
  @@index([expiresAt])
}

/// Một cách đăng nhập của user. 1 user có thể có nhiều ví / nhiều cách đăng nhập.
model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  metadata       Json?
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// Nonce dùng 1 lần cho đăng nhập (chống replay attack)
model AuthNonce {
  id         String       @id @default(cuid())
  nonce      String       @unique
  provider   AuthProvider @default(WALLET)
  /// Địa chỉ ví (chữ thường) hoặc định danh tương ứng provider
  identifier String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime     @default(now())

  @@index([identifier])
  @@index([expiresAt])
}

// ───────────────────────────── Nhà phát triển ─────────────────────────────

enum StudioRole {
  OWNER
  MEMBER
}

/// Studio sở hữu game: developer cá nhân = studio 1 thành viên
model Studio {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  logoKey     String?
  /// Studio chính thức của Game Hub (game do hub tự làm)
  isOfficial  Boolean   @default(false)
  /// Phiên bản điều khoản người đăng game mà studio đã đồng ý (vd "2026-11-09")
  termsVersion      String?
  termsAcceptedAt   DateTime?
  termsAcceptedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  members StudioMember[]
  games   Game[]
}

model StudioMember {
  studioId  String
  userId    String
  role      StudioRole @default(MEMBER)
  createdAt DateTime   @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([studioId, userId])
  @@index([userId])
}

// ───────────────────────────── Game ─────────────────────────────

enum GameStatus {
  DRAFT // developer đang chuẩn bị
  PENDING_REVIEW // chờ admin duyệt lần đầu
  PUBLISHED // hiển thị và chơi được
  MAINTENANCE // hiển thị nhưng tạm khóa chơi
  SUSPENDED // bị khóa do vi phạm
  ARCHIVED // ngừng hoạt động, giữ lại dữ liệu
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  translations CategoryTranslation[]
  games        GameCategory[]
}

model CategoryTranslation {
  categoryId String
  locale     String
  name       String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
}

model Game {
  id               String     @id @default(cuid())
  slug             String     @unique
  studioId         String
  status           GameStatus @default(DRAFT)
  thumbnailKey     String?
  sortOrder        Int        @default(0)
  /// Cấu hình riêng (vd: { "minPlaySeconds": 5, "maxSessionHours": 6 })
  settings         Json       @default("{}")
  /// Phiên bản đang chạy cho người chơi
  currentVersionId String?    @unique
  publishedAt      DateTime?
  /// Domain được gọi Client API (/api/p1) khi game chạy ngoài hub, vd "https://mygame.io"
  allowedOrigins   String[]   @default([])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  studio         Studio            @relation(fields: [studioId], references: [id])
  currentVersion GameVersion?      @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       GameVersion[]     @relation("GameVersions")
  translations   GameTranslation[]
  categories     GameCategory[]
  leaderboards   Leaderboard[]
  sessions       GameSession[]
  scores         Score[]
  events         Event[]
  reports        GameReport[]
  apiKeys        ApiKey[]

  @@index([status, sortOrder])
  @@index([studioId])
}

model GameTranslation {
  gameId      String
  locale      String
  name        String
  description String?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, locale])
}

model GameCategory {
  gameId     String
  categoryId String

  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([gameId, categoryId])
  @@index([categoryId])
}

enum VersionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Mỗi lần upload bản build = 1 phiên bản. Có thể quay lại bản cũ.
model GameVersion {
  id           String        @id @default(cuid())
  gameId       String
  /// Tên phiên bản do developer đặt, vd "1.0.0"
  version      String
  /// Thư mục chứa bản build trong kho lưu trữ, vd "games/2048/1.0.0"
  storageKey   String
  entryFile    String        @default("index.html")
  sizeBytes    Int?
  /// Phiên bản giao thức SDK game dùng (để hub tương thích ngược)
  sdkVersion   Int           @default(1)
  status       VersionStatus @default(DRAFT)
  releaseNotes String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdById  String?
  createdAt    DateTime      @default(now())

  game      Game          @relation("GameVersions", fields: [gameId], references: [id], onDelete: Cascade)
  currentOf Game?         @relation("CurrentVersion")
  sessions  GameSession[]

  @@unique([gameId, version])
  @@index([status])
}

// ───────────────────────────── Bảng xếp hạng & điểm ─────────────────────────────

enum ScoreOrder {
  DESC // điểm càng cao càng tốt
  ASC // càng thấp càng tốt (vd: thời gian hoàn thành)
}

/// Mỗi game có ≥1 bảng xếp hạng. Giải đấu = bảng xếp hạng có startsAt/endsAt.
model Leaderboard {
  id        String     @id @default(cuid())
  gameId    String
  /// Định danh trong game, vd "default", "hard-mode", "tet-2027"
  key       String
  order     ScoreOrder @default(DESC)
  startsAt  DateTime?
  endsAt    DateTime?
  /// Cấu hình (vd: { "maxScore": 4000000 })
  settings  Json       @default("{}")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  game         Game                     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  translations LeaderboardTranslation[]
  scores       Score[]

  @@unique([gameId, key])
}

model LeaderboardTranslation {
  leaderboardId String
  locale        String
  name          String

  leaderboard Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  @@id([leaderboardId, locale])
}

/// Một lượt chơi. Điểm chỉ được nộp khi gắn với 1 lượt chơi hợp lệ.
model GameSession {
  id            String    @id @default(cuid())
  userId        String
  gameId        String
  gameVersionId String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  metadata      Json?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameVersion GameVersion? @relation(fields: [gameVersionId], references: [id], onDelete: SetNull)
  scores      Score[]

  @@index([userId, gameId])
  @@index([startedAt])
}

model Score {
  id              String   @id @default(cuid())
  userId          String
  /// Lưu thêm gameId để thống kê theo game không cần join
  gameId          String
  leaderboardId   String
  sessionId       String
  /// BigInt để chứa điểm rất lớn (game idle, clicker)
  value           BigInt
  durationSeconds Int
  createdAt       DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  leaderboard Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  session     GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Mỗi lượt chơi nộp tối đa 1 điểm cho mỗi bảng xếp hạng
  @@unique([sessionId, leaderboardId])
  @@index([leaderboardId, value])
  @@index([leaderboardId, createdAt])
  @@index([userId, leaderboardId])
  @@index([gameId, createdAt])
}

// ───────────────────────────── Nhật ký sự kiện ─────────────────────────────

/// Nhật ký chỉ ghi thêm: lượt chơi, nộp điểm, (sau này) lượt xem quảng cáo…
/// Dùng cho thống kê và chia doanh thu với developer.
model Event {
  id        String   @id @default(cuid())
  /// vd "session.start", "score.submit", "ad.rewarded"
  type      String
  userId    String?
  gameId    String?
  data      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  game Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([gameId, createdAt])
}

// ───────────────────────────── Báo cáo vi phạm ─────────────────────────────

enum ReportReason {
  BROKEN // game lỗi, không chơi được
  INAPPROPRIATE // nội dung phản cảm / không phù hợp
  COPYRIGHT // vi phạm bản quyền
  CHEATING // bảng xếp hạng có dấu hiệu gian lận
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED // đã xử lý (vd: khóa game, xóa điểm)
  DISMISSED // không vi phạm
}

/// Người chơi báo cáo game; admin xử lý trong trang Quản trị
model GameReport {
  id           String       @id @default(cuid())
  gameId       String
  reporterId   String
  reason       ReportReason
  message      String?
  status       ReportStatus @default(OPEN)
  /// Ghi chú xử lý của admin
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  game     Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([gameId, status])
  @@index([reporterId, gameId])
}

// ───────────────────────────── Platform (PaaS) ─────────────────────────────

enum ApiKeyKind {
  PUBLISHABLE // pk_… – dán vào game, công khai, luôn đi kèm kiểm tra domain
  SECRET // sk_… – chỉ dùng trên máy chủ của developer (Phase 12b)
}

/// Khóa Client API / Server API của 1 game. Chỉ lưu bản băm SHA-256; khóa đầy đủ chỉ hiện 1 lần lúc tạo.
model ApiKey {
  id          String     @id @default(cuid())
  gameId      String
  kind        ApiKeyKind
  /// Vài ký tự đầu để nhận diện trên giao diện (vd "pk_live_a1b2")
  prefix      String
  keyHash     String     @unique
  createdById String?
  createdAt   DateTime   @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}
