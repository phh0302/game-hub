# Sao thành deploy/.env rồi điền. KHÔNG commit file .env.
# Tạo chuỗi bí mật: openssl rand -hex 32

# Database (Neon – dùng chuỗi giống Vercel). Chạy Postgres trong compose: --profile db và
# DATABASE_URL=postgresql://gamehub:<POSTGRES_PASSWORD>@db:5432/gamehub
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# POSTGRES_PASSWORD=

JWT_SECRET=
ADMIN_WALLETS=
CRON_SECRET=
# Token nội bộ giữa app và Redis (srh) – chuỗi ngẫu nhiên
REDIS_REST_TOKEN=

# Tên miền
NEXT_PUBLIC_APP_URL=https://play.monlabs.fun
HUB_HOST=play.monlabs.fun
STATS_HOST=stats.monlabs.fun
STATS_URL=https://stats.monlabs.fun
LANDING_HOST=monlabs.fun
DOCS_HOST=docs.monlabs.fun

# Kho file: s3 = Cloudflare R2 (giống Vercel) | local = volume trên VPS (nginx phục vụ /uploads/u/)
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_BUCKET=gamehub-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Gắn vào JS lúc build – đổi thì phải build lại: docker compose build
NEXT_PUBLIC_UPLOAD_BASE_URL=
NEXT_PUBLIC_GAME_BASE_URL=
NEXT_PUBLIC_ASSET_BASE_URL=

# Theo dõi & cảnh báo (docs/TRAFFIC.md)
TRAFFIC_SAMPLE_RATE=0.2
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=
