# Kết nối PostgreSQL khi chạy web
# - Máy dev: khớp với docker-compose.yml
# - Production (Neon/Supabase): dùng URL "pooled" (qua pooler, có -pooler hoặc cổng 6543)
DATABASE_URL="postgresql://gamehub:gamehub@localhost:5433/gamehub?schema=public"

# Kết nối trực tiếp (không qua pooler) để chạy migration – máy dev: giống hệt DATABASE_URL
# Production: Vercel tự tạo biến này khi kết nối database Neon vào project (Storage → Connect Project)
DATABASE_URL_UNPOOLED="postgresql://gamehub:gamehub@localhost:5433/gamehub?schema=public"

# Khóa ký JWT – chuỗi ngẫu nhiên tối thiểu 32 ký tự, production PHẢI khác máy dev
# Tạo mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu"

# Ví được CẤP quyền admin khi đăng nhập, cách nhau bằng dấu phẩy (vd: 0xabc...,0xdef...)
# Xóa ví khỏi đây KHÔNG thu hồi quyền – muốn thu hồi thì sửa role trong database (npm run db:studio)
ADMIN_WALLETS=""

# URL gốc của web – domain này phải khớp với domain trong thông điệp SIWE (đăng nhập ví)
# Production: https://<ten-du-an>.vercel.app hoặc domain riêng
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Nơi chứa file (ảnh, bản build game). Mặc định: thư mục public/uploads
# Sau này chuyển sang CDN / Cloudflare R2 chỉ cần đổi 2 dòng này, không sửa database
NEXT_PUBLIC_ASSET_BASE_URL="/uploads"
# Game của developer nên chạy ở domain riêng để cô lập với hub (vd: https://games.gamehub.vn)
NEXT_PUBLIC_GAME_BASE_URL="/uploads"

# ── Kho lưu file người dùng upload (bản build game của developer, ảnh bìa) ──
# local = lưu vào public/uploads/u trên máy (CHỈ dùng khi phát triển)
# s3    = Cloudflare R2 / AWS S3 / MinIO (bắt buộc ở production – Vercel không cho ghi file)
STORAGE_DRIVER="local"
# URL công khai của kho – production nên là domain KHÁC hub (vd: https://pub-xxxx.r2.dev hoặc https://cdn.gamehub.vn)
NEXT_PUBLIC_UPLOAD_BASE_URL="/uploads"
# Chỉ cần khi STORAGE_DRIVER="s3" (R2: Cloudflare → R2 → Manage API tokens)
S3_ENDPOINT=""          # vd: https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=""            # vd: gamehub-uploads
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# ----- Chống spam + theo dõi lỗi (không bắt buộc ở máy dev, xem docs/DEPLOY.md mục 3c) -----
# Upstash Redis: rate limit dùng chung cho mọi server. Tích hợp trên Vercel tự tạo KV_REST_API_URL / KV_REST_API_TOKEN
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Sentry: để trống = chỉ ghi lỗi ra console
SENTRY_DSN=""
